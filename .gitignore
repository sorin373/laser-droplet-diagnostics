# -----------------------------
# Build directories
# -----------------------------
/build/
/out/
/cmake-build-*/

# -----------------------------
# CMake generated files
# -----------------------------
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
CTestTestfile.cmake
compile_commands.json

# -----------------------------
# Compiled binaries / objects
# -----------------------------
*.exe
*.dll
*.so
*.dylib
*.a
*.lib
*.o
*.obj
*.pdb

# -----------------------------
# IDE / editor files
# -----------------------------
.vscode/
.idea/
*.suo
*.user
*.userosscache
*.sln
*.vcxproj*
.vs/

# -----------------------------
# OS files
# -----------------------------
.DS_Store
Thumbs.db
desktop.ini

# -----------------------------
# Experimental data
# -----------------------------
/data/raw/
/data/calibration/raw/

# Keep small test data committed
!/data/test/
!/data/test/**

# -----------------------------
# Generated results
# -----------------------------
/results/*
!/results/.gitkeep

# -----------------------------
# Logs / temporary files
# -----------------------------
*.log
*.tmp
*.temp
*.bak
*~

# -----------------------------
# Python helper scripts cache
# if you later use Python
# -----------------------------
__pycache__/
*.pyc
.venv/
venv/

# -----------------------------
# Large binary data formats
# -----------------------------
*.tif
*.tiff
*.avi
*.mp4
*.mov
*.h5
*.hdf5
*.npy
*.npz